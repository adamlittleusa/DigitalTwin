OPENAI_API_KEY=
TWIN_MODEL=gpt-5.4-mini
PUSHOVER_USER=
PUSHOVER_TOKEN=
# Optional. Leave blank to use <repo>/knowledge.
KNOWLEDGE_DIR=

# API service. Every value below is optional; the default is shown.
TWIN_ALLOWED_ORIGINS=http://localhost:3000
TWIN_SITE_URL=https://adambuilds.ai
TWIN_TRUST_PROXY=false
# Required when TWIN_TRUST_PROXY is true. Any long random string.
TWIN_LOG_SALT=
# Header a trusted proxy sets with the real client address; Fly sets Fly-Client-IP. Blank means use X-Forwarded-For.
TWIN_CLIENT_IP_HEADER=
TWIN_PER_CLIENT_HOURLY=20
TWIN_PER_CLIENT_BURST=5
TWIN_MAX_USER_MESSAGES=8
TWIN_DAILY_CALL_LIMIT=500
TWIN_PUSHOVER_HOURLY=10
TWIN_MODEL_TIMEOUT_SECONDS=60
# The address the API listens on: 127.0.0.1 by default, 0.0.0.0 inside the container image.
# Leave it commented out: a value here would override the image's setting under `docker run --env-file`.
# TWIN_HOST=127.0.0.1
PORT=8080
